/* ══════════════════════════════════════════════════════════════
   根容器
══════════════════════════════════════════════════════════════ */

.container {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #1a1a2e;
}

/* ══════════════════════════════════════════════════════════════
   地图
══════════════════════════════════════════════════════════════ */

.map {
  width: 100%;
  height: 100%;
}

/* ══════════════════════════════════════════════════════════════
   控制按钮
══════════════════════════════════════════════════════════════ */

.controls {
  position: absolute;
  right: 32rpx;
  /* 悬浮在统计条上方 */
  bottom: calc(88rpx + env(safe-area-inset-bottom) + 80rpx);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.ctrl-btn {
  width: 88rpx;
  height: 88rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.18);
}

.ctrl-icon {
  font-size: 40rpx;
  line-height: 1;
}

/* ══════════════════════════════════════════════════════════════
   全国统计滚动条（Ticker）
══════════════════════════════════════════════════════════════ */

.ticker-bar {
  position: absolute;
  bottom: calc(env(safe-area-inset-bottom) + 0rpx);
  left: 0;
  right: 0;
  height: 72rpx;
  background: rgba(20, 20, 40, 0.88);
  backdrop-filter: blur(10px);
  overflow: hidden;
  display: flex;
  align-items: center;
  z-index: 20;
}

.ticker-bar--loading {
  justify-content: center;
}

.ticker-placeholder {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.ticker-track {
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
}

/* 内容是双倍文字，translateX(-50%) 正好走完一遍 */
.ticker-content {
  display: inline-block;
  white-space: nowrap;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 0.02em;
  padding-left: 100%;          /* 从屏幕右侧外开始 */
  animation: ticker 28s linear infinite;
  will-change: transform;
}

@keyframes ticker {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

/* ══════════════════════════════════════════════════════════════
   图例
══════════════════════════════════════════════════════════════ */

.legend {
  position: absolute;
  /* 悬浮在 ticker 上方 */
  bottom: calc(72rpx + env(safe-area-inset-bottom) + 20rpx);
  left: 32rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.88);
  padding: 10rpx 20rpx;
  border-radius: 40rpx;
  backdrop-filter: blur(8px);
}

.legend-label {
  font-size: 22rpx;
  color: #555;
  font-weight: 500;
}

.legend-bar {
  width: 120rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: linear-gradient(to right,
    #E53935, #FB8C00, #FDD835, #43A047, #0288D1, #7E57C2);
}

/* ══════════════════════════════════════════════════════════════
   加载遮罩
══════════════════════════════════════════════════════════════ */

.loading-overlay {
  position: absolute;
  inset: 0;
  background: rgba(26, 26, 46, 0.65);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  z-index: 50;
}

.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
}

.spinner--dark {
  border-color: rgba(0, 0, 0, 0.1);
  border-top-color: #1a1a2e;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text {
  color: rgba(255, 255, 255, 0.85);
  font-size: 28rpx;
}

/* ══════════════════════════════════════════════════════════════
   通用背景遮罩
══════════════════════════════════════════════════════════════ */

.backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0);
  pointer-events: none;
  transition: background 0.3s ease;
  z-index: 90;
}

.backdrop--on {
  background: rgba(0, 0, 0, 0.45);
  pointer-events: all;
}

/* ══════════════════════════════════════════════════════════════
   底部面板（提交 + 统计共用基础样式）
══════════════════════════════════════════════════════════════ */

.sheet {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 20rpx 40rpx calc(env(safe-area-inset-bottom) + 40rpx);
  transform: translateY(100%);
  transition: transform 0.38s cubic-bezier(0.32, 0.72, 0, 1);
}

.sheet--open { transform: translateY(0); }

.handle {
  width: 72rpx;
  height: 8rpx;
  background: #e0e0e0;
  border-radius: 4rpx;
  margin: 0 auto 28rpx;
}

/* ── 提交面板内容 ─────────────────────────────────────────── */

.sheet-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #1a1a2e;
  text-align: center;
  margin-bottom: 8rpx;
}

.sheet-hint {
  display: block;
  font-size: 26rpx;
  color: #aaa;
  text-align: center;
  margin-bottom: 36rpx;
}

.mood-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 18rpx;
  margin-bottom: 28rpx;
}

.mood-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 16rpx 0;
  border-radius: 20rpx;
  border: 3rpx solid var(--c);
  background: transparent;
  transition: transform 0.12s ease, background 0.12s ease, box-shadow 0.12s ease;
  will-change: transform;
}

.mood-cell--on {
  background: var(--c);
  transform: scale(1.10);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.18);
}

.mood-num {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--c);
  line-height: 1;
}

.mood-cell--on .mood-num { color: #fff; }

.mood-emoji { font-size: 24rpx; line-height: 1; }

.mood-preview {
  height: 0;
  overflow: hidden;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: height 0.2s ease;
  margin-bottom: 0;
}

.mood-preview--on { height: 72rpx; margin-bottom: 28rpx; }

.mood-preview-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.sheet-actions { display: flex; gap: 24rpx; align-items: center; }

.btn-cancel {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  border: 2rpx solid #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #888;
  background: transparent;
}

.btn-cancel--full { flex: none; width: 100%; }

.btn-submit {
  flex: 2;
  height: 96rpx;
  border-radius: 48rpx;
  border: none;
  font-size: 32rpx;
  font-weight: 600;
  background: #ddd;
  color: #bbb;
  transition: background 0.2s, color 0.2s;
  margin: 0;
  padding: 0;
  line-height: 96rpx;
}

.btn-submit::after { border: none; }
.btn-submit--active { background: #1a1a2e; color: #fff; }

/* ══════════════════════════════════════════════════════════════
   统计面板
══════════════════════════════════════════════════════════════ */

.stats-sheet { max-height: 80vh; overflow-y: auto; }

.stats-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 60rpx 0;
}

.stats-loading-text { font-size: 28rpx; color: #aaa; }

.stats-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 60rpx 0;
}

.stats-empty-icon  { font-size: 80rpx; }
.stats-empty-title { font-size: 32rpx; font-weight: 600; color: #333; }
.stats-empty-hint  { font-size: 26rpx; color: #aaa; }

.stats-header {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-bottom: 40rpx;
}

.stats-avg-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 6rpx solid #ccc;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: border-color 0.3s;
}

.stats-avg-num { font-size: 56rpx; font-weight: 800; line-height: 1; }
.stats-avg-label { font-size: 20rpx; color: #aaa; margin-top: 4rpx; }

.stats-meta { display: flex; flex-direction: column; gap: 8rpx; }
.stats-count { font-size: 34rpx; font-weight: 700; color: #1a1a2e; }
.stats-radius { font-size: 24rpx; color: #aaa; }

.dist-section { margin-bottom: 36rpx; }

.dist-title, .entries-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #aaa;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-bottom: 20rpx;
}

.dist-bars { display: flex; flex-direction: column; gap: 12rpx; }

.dist-row { display: flex; align-items: center; gap: 12rpx; }

.dist-label {
  width: 28rpx;
  font-size: 24rpx;
  color: #555;
  font-weight: 600;
  text-align: right;
  flex-shrink: 0;
}

.dist-bar-track {
  flex: 1;
  height: 18rpx;
  background: #f0f0f0;
  border-radius: 9rpx;
  overflow: hidden;
}

.dist-bar-fill {
  height: 100%;
  border-radius: 9rpx;
  min-width: 4rpx;
  transition: width 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

.dist-pct { width: 64rpx; font-size: 22rpx; color: #aaa; text-align: right; }

.entries-section { margin-bottom: 32rpx; }
.entries-scroll { max-height: 320rpx; }

.entry-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.entry-dot { width: 16rpx; height: 16rpx; border-radius: 50%; flex-shrink: 0; }
.entry-emoji { font-size: 28rpx; flex-shrink: 0; }
.entry-mood { font-size: 30rpx; font-weight: 700; color: #1a1a2e; flex-shrink: 0; width: 30rpx; }
.entry-dist { font-size: 24rpx; color: #aaa; flex: 1; }
.entry-time { font-size: 24rpx; color: #bbb; flex-shrink: 0; }

.stats-close-row { margin-top: 8rpx; }

/* ══════════════════════════════════════════════════════════════
   首次引导遮罩
══════════════════════════════════════════════════════════════ */

.onboarding {
  position: absolute;
  inset: 0;
  background: rgba(10, 10, 30, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  padding: 48rpx 40rpx;
  /* 默认隐藏 */
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.onboarding--on {
  opacity: 1;
  pointer-events: all;
}

.ob-card {
  background: #fff;
  border-radius: 40rpx;
  padding: 56rpx 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  max-width: 680rpx;
}

.ob-logo {
  font-size: 88rpx;
  line-height: 1;
  margin-bottom: 16rpx;
}

.ob-title {
  font-size: 52rpx;
  font-weight: 800;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.ob-subtitle {
  font-size: 28rpx;
  color: #888;
  margin-bottom: 48rpx;
}

/* 步骤列表 */
.ob-steps {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-bottom: 40rpx;
}

.ob-step {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.ob-step-icon {
  font-size: 48rpx;
  line-height: 1;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.ob-step-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.ob-step-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  line-height: 1.4;
}

.ob-step-desc {
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}

/* 隐私提示 */
.ob-privacy {
  width: 100%;
  background: #f5f5f7;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 40rpx;
}

.ob-privacy-text {
  font-size: 24rpx;
  color: #555;
  text-align: center;
  line-height: 1.6;
}

/* 开始按钮 */
.ob-btn {
  width: 100%;
  height: 100rpx;
  background: #1a1a2e;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ob-btn-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 0.05em;
}

/* ══════════════════════════════════════════════════════════════
   Toast 提示
══════════════════════════════════════════════════════════════ */

.toast {
  position: absolute;
  bottom: calc(72rpx + env(safe-area-inset-bottom) + 40rpx);
  left: 50%;
  z-index: 200;
  background: rgba(26, 26, 46, 0.88);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  padding: 20rpx 48rpx;
  border-radius: 48rpx;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transform: translateX(-50%) translateY(16rpx);
  transition: opacity 0.28s ease, transform 0.28s ease;
}

.toast--on { opacity: 1; transform: translateX(-50%) translateY(0); }
.toast--error { background: rgba(198, 40, 40, 0.9); }
.toast-text { display: block; }

/* ══════════════════════════════════════════════════════════════
   提交反馈卡片（全屏覆盖）
══════════════════════════════════════════════════════════════ */

.feedback-overlay {
  position: absolute;
  inset: 0;
  z-index: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(10, 10, 28, 0.92);
  backdrop-filter: blur(12px);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.35s ease;
}

.feedback-overlay--on {
  opacity: 1;
  pointer-events: all;
}

.feedback-glow {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.feedback-card {
  position: relative;
  width: 100%;
  max-width: 680rpx;
  background: rgba(22, 22, 42, 0.95);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  border-radius: 48rpx;
  padding: 60rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feedback-close {
  position: absolute;
  top: 28rpx;
  right: 32rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feedback-close-icon {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.4);
}

.feedback-num {
  font-size: 120rpx;
  font-weight: 800;
  line-height: 1;
  margin-bottom: 20rpx;
}

.feedback-bar-track {
  width: 80%;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
}

.feedback-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

.feedback-title {
  font-size: 44rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.92);
  margin-bottom: 32rpx;
  text-align: center;
}

.feedback-divider {
  width: 80%;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.10);
  margin-bottom: 32rpx;
}

.feedback-stats {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.feedback-stat-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.feedback-stat-icon {
  font-size: 32rpx;
  line-height: 1.5;
  flex-shrink: 0;
}

.feedback-stat-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.80);
  line-height: 1.5;
  flex: 1;
}

.feedback-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.feedback-btn-share {
  width: 100%;
  height: 96rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.92);
}

.feedback-btn-share--loading {
  opacity: 0.5;
}

.feedback-btn-close {
  width: 100%;
  height: 96rpx;
  background: transparent;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.40);
}

.feedback-privacy {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.25);
  text-align: center;
}

/* ══════════════════════════════════════════════════════════════
   城市排行榜面板
══════════════════════════════════════════════════════════════ */

.lb-sheet { max-height: 82vh; display: flex; flex-direction: column; }

.lb-scroll { flex: 1; max-height: 56vh; }

.lb-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.lb-row--highlight {
  background: rgba(255, 235, 59, 0.08);
  border-radius: 12rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
}

.lb-rank {
  width: 56rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #aaa;
  text-align: center;
  flex-shrink: 0;
}

.lb-rank--top { font-size: 36rpx; }

.lb-city {
  width: 100rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  flex-shrink: 0;
}

.lb-bar-track {
  flex: 1;
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
}

.lb-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

.lb-avg {
  width: 52rpx;
  font-size: 30rpx;
  font-weight: 800;
  text-align: right;
  flex-shrink: 0;
}

.lb-count {
  width: 64rpx;
  font-size: 22rpx;
  color: #bbb;
  text-align: right;
  flex-shrink: 0;
}
